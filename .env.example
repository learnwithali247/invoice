# ---------------------------------------------------------------------------
# PUBLIC (safe to expose in the browser — only these are bundled)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ayuzkbjywyzryotwnbpk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_B8qGs-YPmPcyg3OFnXQo_g_58tkj9zR

# Absolute base URL of this deployment. Used for public invoice / payment links.
# Leave empty in local dev — falls back to http://localhost:3000
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# SERVER ONLY (never exposed to the browser, never commit real values)
# ---------------------------------------------------------------------------
# Supabase service-role / secret key. Server-side only.
# Supabase Dashboard -> Project Settings -> API Keys
SUPABASE_SECRET_KEY=

# Optional: a personal access token (https://supabase.com/dashboard/account/tokens)
# used ONCE by `npm run db:push` to apply the migration for you. Not used at
# runtime. Delete it from this file once the migration has been applied.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# PAYMENTS  (server-side only)
# PAYMENT_MODE: "test" | "live" | "disabled"
# ---------------------------------------------------------------------------
PAYMENT_MODE=test

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public app URL for Stripe redirect return (e.g. https://your-domain.com)
STRIPE_RETURN_URL=

# PayPal — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# EMAIL (server-side only) — EMAIL_PROVIDER: "console" | "resend" | "none"
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM="Invoice Generator <no-reply@example.com>"
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# DEV-ONLY demo/test account seeding (scripts/seed.mjs). Never used at runtime.
# ---------------------------------------------------------------------------
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
TEST_ACCOUNT_NAME=Demo User
